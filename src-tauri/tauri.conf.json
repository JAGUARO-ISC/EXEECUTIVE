{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EXEECUTIVE",
  "version": "1.0.10",
  "identifier": "com.jaguarox.exeecutive",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --dir src/renderer dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "pnpm --dir src/renderer build",
      "cwd": ".."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMzFCNTg1MzkyM0UwQTIKUldTaTRDTTVoYlV4eWdGczNtWlQ3dTYvMFFwRUd2QXMzYnZic2V0VTFORVNpaDBIUTJnSE9aWTIK",
      "endpoints": [
        "https://github.com/JAGUARO-ISC/EXEECUTIVE/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EXEECUTIVE",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "JaguaroX",
    "shortDescription": "Personal and business management",
    "longDescription": "EXEECUTIVE personal and business management for Windows.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "EXEECUTIVE",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
