{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EXECUTIVE",
  "version": "1.0.0",
  "identifier": "com.executive.app",
  "build": {
    "beforeDevCommand": "pnpm --dir src/renderer dev",
    "beforeBuildCommand": "pnpm --dir src/renderer build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EXECUTIVE",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
